{
  "schema_version": 1,
  "scenario_id": "colorless_09_02_02c_01_boundary",
  "card_id": "colorless_09_02_02c_01",
  "scenario_kind": "boundary",
  "official_rule": "JP: 【常時】\n『システム管理権限』他のBP1000以下のミニオン全ては、アタックもブロックも移動もできない。\n【自分のターン開始時】\nミニオン全てにBP+100を付与する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_09_02_02c_01",
        "zone": "field",
        "seed": 2094997432,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_03_02_02c_01",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "p1_low": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/card-state",
      "payload": {
        "iid": "$p1_low",
        "permanentBpModifier": 500
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_03_02_02c_01",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "p2_high": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/card-state",
      "payload": {
        "iid": "$p2_high",
        "permanentBpModifier": 501
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P2",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "the BP1001 Minion attacks P1",
      "prompt_kind": "main_action",
      "select": {
        "kind": "attack",
        "cardIid": "$p2_high"
      }
    },
    {
      "name": "target P1 player",
      "prompt_kind": "attack_target",
      "select": {
        "kind": "player"
      }
    },
    {
      "name": "P1 passes Flash priority",
      "prompt_kind": "flash_action",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "name": "P2 passes Flash priority",
      "prompt_kind": "flash_action",
      "select": {
        "kind": "flash_pass"
      }
    }
  ],
  "assertions": [
    {
      "name": "BP1000 is still within the restriction threshold",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$p1_low",
        "effectiveBp": 1000
      }
    },
    {
      "name": "BP1001 is above the restriction threshold",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$p2_high",
        "effectiveBp": 1001
      }
    },
    {
      "name": "the attack reaches the actual blocker prompt",
      "path": "state.prompt.kind",
      "op": "eq",
      "value": "blocker"
    },
    {
      "name": "the BP1000 Minion is not offered as a blocker",
      "path": "state.prompt.options",
      "op": "none_where",
      "where": {
        "iid": "$p1_low"
      }
    }
  ]
}
