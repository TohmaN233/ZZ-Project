    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Retreat Leafa to Base",
      "select": {
        "kind": "move_card",
        "iid": "$primary",
        "direction": "field_to_base"
      }
    },
    {
      "prompt_kind": "effect_target",
      "name": "Search for the Yellow Wing Base Minion",
      "select": {
        "cardIid": "$wing"
      }
    }
  ],
  "assertions": [
    {
      "name": "Leafa enters Base rested",
      "path": "state.players.human.base",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "colorless_01_02_02c_01",
        "rested": true
      }
    },
    {
      "name": "The Yellow Wing Base Minion enters hand",
      "path": "state.players.human.hand",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "yellow_00_01_02c_00"
      }
    },
    {
      "name": "The non-Yellow Wing remains in Deck",
      "path": "state.players.human.deckCount",
      "op": "eq",
      "value": 1
    },
    {
      "name": "Only the searched Wing card is revealed",
      "path": "state.publicReveals",
      "op": "count_where",
      "value": 1,
      "where": {
        "reason": "deck_search",
        "card": {
          "cardId": "yellow_00_01_02c_00"
        }
