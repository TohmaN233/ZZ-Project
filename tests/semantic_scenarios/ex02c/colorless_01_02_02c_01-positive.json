{
  "schema_version": 1,
  "scenario_id": "colorless_01_02_02c_01_positive",
  "card_id": "colorless_01_02_02c_01",
  "scenario_kind": "positive",
  "official_rule": "JP: 《ベース》【後退時】自分はデッキの中から種族「ウイング」を持つ黄のベース・ミニオンカード1枚を公開して手札に加えることができる。その後、自分のデッキをシャッフルする。\n【常時】このミニオンはベースに移動するとき、レスト状態で移動する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_01_02_02c_01",
        "zone": "field",
        "seed": 1293998712,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "primary": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "colorless_01_02_02c_01"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "yellow_00_01_02c_00",
        "side": "P1",
        "zone": "deck",
        "rested": false
      },
      "capture": {
        "wing": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "green_00_01_02c_01",
        "side": "P1",
        "zone": "deck",
        "rested": false
      },
      "capture": {
        "wrong_color": {
          "path": "debug.added.iid"
        }
      }
