  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Bless Berkuli with Item Mana",
      "select": {
        "kind": "bless",
        "iid": "$item",
        "target_iid": "$initial"
      }
    },
    {
      "prompt_kind": "main_action",
      "name": "Cast Enhance Armament",
      "select": {
        "kind": "play_card",
        "cardId": "green_03_03_02c_00"
      }
    },
    {
      "prompt_kind": "effect_target",
      "name": "Rest the enemy Minion",
      "select": {
        "cardId": "green_04_02_02c_00"
      }
    },
    {
      "prompt_kind": "main_action",
      "name": "End Berkuli controller turn",
      "select": {
        "kind": "end_turn"
      }
    },
    {
      "prompt_kind": "main_action",
      "name": "Skip the opponent mana placement",
      "select": {
        "kind": "place_colorless_mana"
      }
    },
    {
      "prompt_kind": "main_action",
      "name": "Attack with the opposing Minion to trigger Berkuli effect",
      "select": {
        "kind": "attack",
        "cardId": "green_04_02_02c_00"
      }
    },
    {
      "prompt_kind": "attack_target",
