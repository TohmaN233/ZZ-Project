        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass opponent Flash priority",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "blocker",
      "name": "Do not block so the opponent Minion completes its attack and rests",
      "select": {
