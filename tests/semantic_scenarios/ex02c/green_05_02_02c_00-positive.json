  "assertions": [
    {
      "name": "The opponent Minion BP returns to normal at the opponent turn end",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "green_04_02_02c_00",
        "rested": true,
        "effectiveBp": 600
      }
    },
    {
      "name": "The Item Mana remains attached to Berkuli",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "green_05_02_02c_00",
        "blessings": {
          "contains": [
            {
              "cardId": "green_00_01_02c_01"
            }
          ]
        }
      }
    },
    {
      "name": "Berkuli no longer carries the granted effect after the opponent turn end",
      "path": "state.players.human.field",
      "op": "none_where",
      "where": {
        "cardId": "green_05_02_02c_00",
        "flags": {
          "contains": [
            "ex02c_berkuli_item_bless_until_opponent_turn_end"
          ]
        }
      }
