{
  "schema_version": 1,
  "scenario_id": "red_00_01_02c_02_positive",
  "card_id": "red_00_01_02c_02",
  "scenario_kind": "positive",
  "official_rule": "JP: 《付与能力》\n【アタック時】\n相手のBP400以下のミニオン1体を破壊する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "red_00_01_02c_02",
        "zone": "base",
        "seed": 3870705182,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "elucidator": {
          "path": "state.players.human.base",
          "where": {
            "cardId": "red_00_01_02c_02"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_04_02_02c_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "host": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_02_02_02c_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_06_02_02c_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Attach Elucidata to Klain",
      "select": {
        "kind": "bless",
        "iid": "$elucidator",
        "target_iid": "$host"
      }
    },
    {
      "prompt_kind": "main_action",
      "name": "Attack with the boosted Klain",
      "select": {
        "kind": "attack",
        "cardId": "red_04_02_02c_00"
      }
    },
    {
      "prompt_kind": "attack_target",
      "name": "Attack the opponent player",
      "select": {
        "kind": "player"
      }
    },
    {
      "prompt_kind": "effect_target",
      "name": "Choose the opposing Minion with BP at most 400",
      "select": {
        "cardId": "red_02_02_02c_00"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass opponent Flash priority",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass controller Flash priority",
      "select": {
        "kind": "flash_pass"
      }
    }
  ],
  "assertions": [
    {
      "name": "Elucidata destroys the selected 200 BP Minion",
      "path": "state.players.opponent.trash",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "red_02_02_02c_00"
      }
    },
    {
      "name": "The 600 BP Minion is outside the effect limit",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "red_06_02_02c_00"
      }
    },
    {
      "name": "Elucidata remains attached to the Sword Minion",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "red_04_02_02c_00",
        "blessings": {
          "contains": [
            {
              "cardId": "red_00_01_02c_02"
            }
          ]
        }
      }
    }
  ]
}
