  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Summon Yui and inspect the top Black Swordsman",
      "select": {
        "kind": "play_card",
        "cardIid": "$yui"
      }
    },
    {
      "prompt_kind": "effect_target",
      "name": "Select the matching private top card",
      "select": {
        "cardId": "colorless_03_02_02c_01"
      }
    }
  ],
  "assertions": [
    {
      "name": "The top Black Swordsman enters hand",
      "path": "state.players.human.hand",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "colorless_03_02_02c_01"
      }
    },
    {
      "name": "Yui publicly reveals the matching top card",
      "path": "state.publicReveals",
      "op": "count_where",
      "value": 1,
      "where": {
        "reason": "deck_search",
        "card": {
          "cardId": "colorless_03_02_02c_01"
        }
      }
    },
    {
      "name": "Only the mismatching Dragon remains in Deck",
      "path": "state.players.human.deckCount",
      "op": "eq",
      "value": 1
    },
    {
      "name": "Yui remains in Field after the top-card check",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "colorless_01_02_02c_03"
      }
    }
