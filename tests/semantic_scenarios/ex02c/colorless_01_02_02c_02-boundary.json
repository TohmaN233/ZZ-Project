  "assertions": [
    {
      "name": "Mandatory placement waits for its target choice",
      "path": "state.prompt.kind",
      "op": "eq",
      "value": "effect_target"
    },
    {
      "name": "The legal Green Item appears in the required target options",
      "path": "state.prompt.options",
      "op": "any_where",
      "where": {
        "kind": "effect_target",
        "cardId": "green_00_01_02c_01"
      }
    },
    {
      "name": "A mandatory placement cannot be skipped",
      "path": "state.prompt.options",
      "op": "none_where",
      "value": 0,
      "where": {
        "kind": "effect_target_skip"
      }
    },
    {
      "name": "The nonmatching Red Item is not a legal target",
      "path": "state.prompt.options",
      "op": "none_where",
      "value": 0,
      "where": {
        "cardId": "red_00_01_02c_01"
      }
    },
    {
      "name": "The Green Field Minion is not a legal target",
      "path": "state.prompt.options",
      "op": "none_where",
      "value": 0,
      "where": {
        "cardId": "green_04_02_02c_00"
      }
    },
    {
      "name": "No target leaves Deck before the required choice",
