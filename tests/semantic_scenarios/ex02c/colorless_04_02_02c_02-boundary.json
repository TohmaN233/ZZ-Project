  "card_id": "colorless_04_02_02c_02",
  "scenario_kind": "boundary",
  "official_rule": "JP: 【召喚時】＆スイッチ：「黒の剣士」\\n自分のコスト2のミニオン1体にBP+100/DP+1を付与する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_04_02_02c_02",
        "zone": "field",
        "seed": 2342091216,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "primary": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "colorless_04_02_02c_02"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_02_02_02c_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "yuna": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_03_02_02c_01",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "kirito": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_03_02_02c_01",
        "side": "P1",
        "zone": "hand",
        "rested": false
      },
      "capture": {
        "black_sword": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Summon a Black Swordsman to Switch Cardinal",
      "select": {
        "kind": "play_card",
        "cardId": "colorless_03_02_02c_01"
      }
    }
  ],
  "assertions": [
    {
      "name": "The Switch target prompt is waiting for a legal cost-2 target",
      "path": "state.prompt.kind",
      "op": "eq",
      "value": "effect_target"
    },
    {
      "name": "The cost-3 Minion is not a legal target",
      "path": "state.prompt.options",
      "op": "none_where",
      "where": {
        "cardIid": "$kirito"
      }
    },
    {
      "name": "The eligible cost-2 Minion is offered",
      "path": "state.prompt.options",
      "op": "any_where",
      "where": {
        "cardIid": "$yuna"
      }
    }
  ]
}
