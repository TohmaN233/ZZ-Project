{
  "schema_version": 1,
  "scenario_id": "colorless_02_02_02c_05_boundary",
  "card_id": "colorless_02_02_02c_05",
  "scenario_kind": "boundary",
  "official_rule": "JP: 【破壊時】お互いはカードを1枚引く。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_02_02_02c_05",
        "zone": "field",
        "seed": 2815670136,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "primary": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "colorless_02_02_02c_05"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_00_01_02c_00",
        "side": "P1",
        "zone": "deck",
        "rested": false
      },
      "capture": {
        "human_draw": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "green_04_02_02c_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "attacker": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": true,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": true,
        "rested": true
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P2",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Attack the player with the stronger opposing Minion",
      "select": {
        "kind": "attack",
        "cardId": "green_04_02_02c_00"
      }
    },
    {
      "prompt_kind": "attack_target",
      "name": "Attack the player whose Forces are destroyed",
      "select": {
        "kind": "player"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass the controller Flash window",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass the opponent Flash window",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "blocker",
      "name": "Block with Illfang",
      "select": {
        "kind": "blocker",
        "cardIid": "$primary"
      }
    }
  ],
  "assertions": [
    {
      "name": "The controller draws from the non-empty Deck",
      "path": "state.players.human.hand",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "red_00_01_02c_00"
      }
    },
    {
      "name": "The empty opposing Deck supplies no card",
      "path": "state.players.opponent.handCount",
      "op": "eq",
      "value": 0
    },
    {
      "name": "The controller Deck is consumed once",
      "path": "state.players.human.deckCount",
      "op": "eq",
      "value": 0
    },
    {
      "name": "The opposing Deck remains empty",
      "path": "state.players.opponent.deckCount",
      "op": "eq",
      "value": 0
    }
  ]
}
