{
  "schema_version": 1,
  "scenario_id": "colorless_05_02_02c_02_positive",
  "card_id": "colorless_05_02_02c_02",
  "scenario_kind": "positive",
  "official_rule": "JP: 【加護時】\\n自分はカードを1枚引く。 EN: ",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_05_02_02c_02",
        "zone": "field",
        "seed": 4260413691,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "primary": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "colorless_05_02_02c_02"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_00_01_02_00",
        "side": "P1",
        "zone": "base",
        "rested": false
      },
      "capture": {
        "blessing": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_00_01_02c_00",
        "side": "P1",
        "zone": "deck",
        "rested": false
      },
      "capture": {
        "drawn": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Bless the card that has the Blessing draw ability",
      "select": {
        "kind": "bless",
        "iid": "$blessing",
        "target_iid": "$primary"
      }
    }
  ],
  "assertions": [
    {
      "name": "The host receives the chosen green Blessing",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "colorless_05_02_02c_02",
        "blessings": {
          "contains": [
            {
              "cardId": "colorless_00_01_02_00"
            }
          ]
        }
      }
    },
    {
      "name": "The host draws one known card",
      "path": "state.players.human.hand",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "red_00_01_02c_00"
      }
    }
  ]
}
