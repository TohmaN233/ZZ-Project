{
  "schema_version": 1,
  "scenario_id": "red_00_01_02c_00_positive",
  "card_id": "red_00_01_02c_00",
  "scenario_kind": "positive",
  "official_rule": "JP: 【常時】\nこのミニオンはブロックできない。\n《ベース》\n【配置時】\nこのターン中、相手のミニオン1体をBP-100する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "red_00_01_02c_00",
        "zone": "field",
        "seed": 279853983,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "pina": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "red_00_01_02c_00"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_07_02_02_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "legal_blocker": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_07_02_02_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P2",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Attack with the opposing Minion",
      "select": {
        "kind": "attack",
        "cardId": "colorless_07_02_02_00"
      }
    },
    {
      "prompt_kind": "attack_target",
      "name": "Attack the P1 player",
      "select": {
        "kind": "player"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass P1 Flash priority",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass P2 Flash priority",
      "select": {
        "kind": "flash_pass"
      }
    }
  ],
  "assertions": [
    {
      "name": "Pina is excluded from the live blocker options",
      "path": "state.prompt.options",
      "op": "none_where",
      "where": {
        "kind": "blocker",
        "cardIid": "$pina"
      }
    },
    {
      "name": "The ordinary Minion remains available to block",
      "path": "state.prompt.options",
      "op": "any_where",
      "where": {
        "kind": "blocker",
        "cardIid": "$legal_blocker"
      }
    },
    {
      "name": "The attack reaches a real blocker decision",
      "path": "state.prompt.kind",
      "op": "eq",
      "value": "blocker"
    }
  ]
}
