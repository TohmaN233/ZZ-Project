{
  "schema_version": 1,
  "scenario_id": "colorless_07_02_02c_01_positive",
  "card_id": "colorless_07_02_02c_01",
  "scenario_kind": "positive",
  "official_rule": "JP: 【召喚時】\nBP300以下のミニオン全てを破壊する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_07_02_02c_01",
        "zone": "hand",
        "seed": 2765841601,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_03_02_02c_01",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "p1_low": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/card-state",
      "payload": {
        "iid": "$p1_low",
        "permanentBpModifier": -200
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_03_02_02c_01",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "p2_low": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/card-state",
      "payload": {
        "iid": "$p2_low",
        "permanentBpModifier": -200
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_03_02_02c_01",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "p2_boundary": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/card-state",
      "payload": {
        "iid": "$p2_boundary",
        "permanentBpModifier": -199
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "summon Skull Reaper",
      "prompt_kind": "main_action",
      "select": {
        "kind": "play_card",
        "cardId": "colorless_07_02_02c_01"
      }
    }
  ],
  "assertions": [
    {
      "name": "the BP300 allied Minion is destroyed",
      "path": "state.players.human.trash",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$p1_low"
      }
    },
    {
      "name": "the BP300 opposing Minion is destroyed",
      "path": "state.players.opponent.trash",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$p2_low"
      }
    },
    {
      "name": "the BP301 opposing Minion survives",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "effectiveBp": 301,
        "iid": "$p2_boundary"
      }
    }
  ]
}
