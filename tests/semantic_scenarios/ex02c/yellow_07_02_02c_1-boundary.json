  "scenario_kind": "boundary",
  "official_rule": "JP: 襲撃\n【変形時】\n相手のBP300以下のミニオン全てを手札に戻す。\n【召喚時】＆ スイッチ：「閃光」\n『絶対最強の剣』\nこのターン中、相手の手札1枚毎に、このミニオンをDP+1する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "yellow_07_02_02c_00",
        "zone": "field",
        "seed": 288415154,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "host": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "yellow_07_02_02c_00"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
