  "assertions": [
    {
      "name": "A Minion at BP301 is outside the transform return limit",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "green_02_02_02c_03",
        "effectiveBp": 301
