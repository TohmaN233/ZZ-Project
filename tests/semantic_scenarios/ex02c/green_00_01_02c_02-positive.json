{
  "schema_version": 1,
  "scenario_id": "green_00_01_02c_02_positive",
  "card_id": "green_00_01_02c_02",
  "scenario_kind": "positive",
  "official_rule": "JP: 加護：「ソード」+コスト4以上\n《付与能力》\n【アタック時】\n相手の有色のミニオン1体をレストする。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "green_00_01_02c_02",
        "zone": "base",
        "seed": 1162641355,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "primary": {
          "path": "state.players.human.base",
          "where": {
            "cardId": "green_00_01_02c_02"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "yellow_05_02_02c_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "host": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_06_02_02c_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_08_02_02c_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Bless the cost-five Sword host",
      "select": {
        "kind": "bless",
        "iid": "$primary",
        "target_iid": "$host"
      }
    },
    {
      "prompt_kind": "main_action",
      "name": "Attack with the blessed host",
      "select": {
        "kind": "attack",
        "cardId": "yellow_05_02_02c_00"
      }
    },
    {
      "prompt_kind": "attack_target",
      "name": "Attack the opponent player",
      "select": {
        "kind": "player"
      }
    },
    {
      "prompt_kind": "effect_target",
      "name": "Choose the opposing colored Minion",
      "select": {
        "cardId": "red_06_02_02c_00"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass the opponent Flash window",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass the controller Flash window",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "blocker",
      "name": "Do not block with the remaining colorless Minion",
      "select": {
        "kind": "no_block"
      }
    }
  ],
  "assertions": [
    {
      "name": "Blue Rose Sword rests the selected colored Minion",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "red_06_02_02c_00",
        "rested": true
      }
    },
    {
      "name": "The colorless Minion remains active and cannot be selected",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "colorless_08_02_02c_00",
        "rested": false
      }
    }
  ]
}
