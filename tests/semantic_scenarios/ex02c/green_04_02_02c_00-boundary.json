      "payload": {
        "cardId": "green_04_02_02c_00",
        "zone": "field",
        "seed": 2802202610,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": false
      },
      "capture": {
        "initial": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "green_04_02_02c_00"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/card-state",
      "payload": {
        "iid": "$initial",
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "green_02_02_02c_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "Attack with an allied Minion",
      "select": {
        "kind": "attack",
        "cardId": "green_02_02_02c_00"
      }
    },
    {
      "prompt_kind": "attack_target",
      "name": "Attack the opponent player",
      "select": {
        "kind": "player"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass the defender Flash window",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "Pass the attacker Flash window",
      "select": {
        "kind": "flash_pass"
      }
    }
  ],
  "assertions": [
    {
      "name": "Kirito stays rested after an allied Minion attacks",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "green_04_02_02c_00",
        "rested": true
      }
