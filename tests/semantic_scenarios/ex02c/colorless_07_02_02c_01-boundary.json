{
  "schema_version": 1,
  "scenario_id": "colorless_07_02_02c_01_boundary",
  "card_id": "colorless_07_02_02c_01",
  "scenario_kind": "boundary",
  "official_rule": "JP: 【召喚時】\nBP300以下のミニオン全てを破壊する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_07_02_02c_01",
        "zone": "hand",
        "seed": 737461543,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_03_02_02c_01",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "p2_boundary": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/card-state",
      "payload": {
        "iid": "$p2_boundary",
        "permanentBpModifier": -199
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "summon Skull Reaper",
      "prompt_kind": "main_action",
      "select": {
        "kind": "play_card",
        "cardId": "colorless_07_02_02c_01"
      }
    }
  ],
  "assertions": [
    {
      "name": "BP301 is not destroyed",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "effectiveBp": 301,
        "iid": "$p2_boundary"
      }
    },
    {
      "name": "no Minion is moved to Trash at the strict BP boundary",
      "path": "state.players.opponent.trash",
      "op": "count_where",
      "value": 0,
      "where": {
        "iid": "$p2_boundary"
      }
    }
  ]
}
