  "actions": [
    {
      "name": "Give Pion a non-Green unconditional Bless",
      "prompt_kind": "main_action",
      "select": {
        "kind": "bless",
        "iid": "$blue_bless",
        "target_iid": "$primary"
      }
    }
  ],
  "assertions": [
    {
      "name": "Pion remains the original face with a non-Green Bless attached",
      "path": "state.players.human.field",
      "op": "any_where",
      "where": {
        "cardId": "green_04_01_03_00",
        "blessings": {
          "contains": [
            {
              "cardId": "colorless_00_01_02_01"
            }
          ]
        }
      }
    },
    {
      "name": "A non-Green Bless does not transform Pion",
      "path": "state.players.human.field",
