{
  "schema_version": 1,
  "scenario_id": "green_04_01_03_00_boundary",
  "card_id": "green_04_01_03_00",
  "scenario_kind": "boundary",
  "official_rule": "JP: 【召喚時】\n相手のコスト3以下のミニオン1体か相手のフォース1つをレストする。それは次の相手のスタンバイフェイズ終了時までアクティブにならない。\n【常時】\nこのミニオンがアクティブ状態でなければ[加護]は付与されない。\n【加護時】\n緑の加護である場合、加護しているマナを除外して、「「虹の魔術師」ピオン」に変形する。 EN: [When Summoned]\nPut one of your opponent's minions or one of their Forces in the\nRest State. The minion must be cost 3 or lower. The target cannot\nreturn to the Active State until your opponent's next Standby Phase\n[Passive]\nThis minion cannot receive a {Boost} when notin the Active State\n[When Boosted]\nIf Boosted by a Green Mana, banish that mana. This card\nTransforms into \"Pion\nThe Rainbow Sorceress\"",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "green_04_01_03_00",
        "zone": "field",
        "seed": 2080167859,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "primary": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "green_04_01_03_00"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
