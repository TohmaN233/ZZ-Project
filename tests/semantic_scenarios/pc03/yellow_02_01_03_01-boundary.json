{
  "schema_version": 1,
  "scenario_id": "yellow_02_01_03_01_boundary",
  "card_id": "yellow_02_01_03_01",
  "scenario_kind": "boundary",
  "official_rule": "JP: 《ベース》【後退時】このターン中、自分の黄のミニオン1体をBP+300する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "yellow_02_01_03_01",
        "zone": "field",
        "seed": 2602,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "primary": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "yellow_02_01_03_01"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "blue_01_01_03_00",
        "side": "P1",
        "zone": "field"
      },
      "capture": {
        "blue_target": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "Retreat Guardian Monkey without a Yellow target",
      "prompt_kind": "main_action",
      "select": {
        "kind": "move_card",
        "iid": "$primary",
        "direction": "field_to_base"
      }
    }
  ],
  "assertions": [
    {
      "name": "A non-Yellow Minion receives no BP bonus",
      "path": "state.players.human.field",
      "op": "any_where",
      "where": {
        "cardId": "blue_01_01_03_00",
        "effectiveBp": 200
      }
    }
  ]
}