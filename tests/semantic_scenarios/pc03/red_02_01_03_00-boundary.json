{
  "schema_version": 1,
  "scenario_id": "red_02_01_03_00_boundary",
  "card_id": "red_02_01_03_00",
  "scenario_kind": "boundary",
  "official_rule": "JP: 【破壊時】\\n相手のミニオン1体にBP-200を付与する。 EN: [When Destroyed]\\nDeal -200BP to one of your opponent's\\nminions.",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "red_02_01_03_00",
        "zone": "field",
        "seed": 3088034444,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "rider": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "red_02_01_03_00"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_01_02_03_00",
        "side": "P2",
        "zone": "hand"
      },
      "capture": {
        "bombball": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_00_00_03_00",
        "side": "P2",
        "zone": "base"
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P2",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "P2 casts Bomb Ball on P1 Trolley Rider",
      "prompt_kind": "main_action",
      "select": {
        "kind": "play_card",
        "iid": "$bombball"
      }
    },
    {
      "name": "Destroy the Trolley Rider while P2 has no Minion",
      "prompt_kind": "effect_target",
      "select": {
        "kind": "effect_target",
        "cardIid": "$rider"
      }
    }
  ],
  "assertions": [
    {
      "name": "The Trolley Rider is destroyed without selecting a BP target",
      "path": "state.players.human.trash",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "red_02_01_03_00"
      }
    },
    {
      "name": "The no-target Rider trigger returns to the normal Main action prompt",
      "path": "state.prompt.kind",
      "op": "eq",
      "value": "main_action"
    }
  ]
}
