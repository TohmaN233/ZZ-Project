{
  "schema_version": 1,
  "scenario_id": "white_06_01_03_00_boundary",
  "card_id": "white_06_01_03_00",
  "scenario_kind": "boundary",
  "official_rule": "JP: 【相手のターン】\n相手のミニオンは自分のフォースにアタックできない。 EN: [On Your Opponent's Turn]\nYour opponent's minions cannot attack\nyour Forces.",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "white_06_01_03_00",
        "zone": "hand",
        "seed": 3030155129,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": true,
        "rested": true,
        "life": 0
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": true,
        "rested": true,
        "life": 0
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "white_06_01_03_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "r_c3": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_04_01_03_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "enemy_attacker": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P2",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "P2 attacks the player",
      "prompt_kind": "main_action",
      "select": {
        "kind": "attack",
        "iid": "$enemy_attacker"
      }
    },
    {
      "name": "Choose P1",
      "prompt_kind": "attack_target",
      "select": {
        "kind": "player"
      }
    },
    {
      "name": "Pass P1 Flash window",
      "prompt_kind": "flash_action",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "name": "Pass P2 Flash window",
      "prompt_kind": "flash_action",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "name": "Do not block the player attack",
      "prompt_kind": "blocker",
      "select": {
        "kind": "no_block"
      }
    }
  ],
  "assertions": [
    {
      "name": "Destroyed Forces are unaffected",
      "path": "state.players.human.forces",
      "op": "count_where",
      "value": 2,
      "where": {
        "destroyed": true
      }
    },
    {
      "name": "R-C3 does not prohibit attacking the player",
      "path": "state.players.human.life",
      "op": "eq",
      "value": 9
    }
  ]
}
