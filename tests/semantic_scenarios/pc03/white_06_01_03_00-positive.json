{
  "schema_version": 1,
  "scenario_id": "white_06_01_03_00_positive",
  "card_id": "white_06_01_03_00",
  "scenario_kind": "positive",
  "official_rule": "JP: 【相手のターン】\n相手のミニオンは自分のフォースにアタックできない。 EN: [On Your Opponent's Turn]\nYour opponent's minions cannot attack\nyour Forces.",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "white_06_01_03_00",
        "zone": "hand",
        "seed": 881567227,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "white_06_01_03_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "r_c3": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "red_04_01_03_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "enemy_attacker": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P2",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "P2 declares an attack",
      "prompt_kind": "main_action",
      "select": {
        "kind": "attack",
        "iid": "$enemy_attacker"
      }
    }
  ],
  "assertions": [
    {
      "name": "R-C3 removes the live Force target",
      "path": "state.prompt.options",
      "op": "none_where",
      "where": {
        "kind": "force",
        "forceId": "force_sho"
      }
    },
    {
      "name": "R-C3 leaves the player attack target available",
      "path": "state.prompt.options",
      "op": "any_where",
      "where": {
        "kind": "player"
      }
    }
  ]
}
