  "assertions": [
    {
      "name": "The placed Base Summoner cannot move",
      "path": "state.players.human.base",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "white_00_00_03_03",
        "flags": {
          "contains": [
            "cannot_move"
          ]
        }
      }
    },
    {
      "name": "The placed Base Summoner has no legal move action",
      "path": "state.prompt.options",
      "op": "none_where",
      "where": {
