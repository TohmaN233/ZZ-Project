{
  "schema_version": 1,
  "scenario_id": "yellow_02_01_03_01_positive",
  "card_id": "yellow_02_01_03_01",
  "scenario_kind": "positive",
  "official_rule": "JP: 《ベース》【後退時】このターン中、自分の黄のミニオン1体をBP+300する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "yellow_02_01_03_01",
        "zone": "field",
        "seed": 2601,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "primary": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "yellow_02_01_03_01"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "yellow_01_01_03_00",
        "side": "P1",
        "zone": "field"
      },
      "capture": {
        "yellow_target": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "blue_01_01_03_00",
        "side": "P1",
        "zone": "field"
      },
      "capture": {
        "blue_target": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "Move Guardian Monkey to Base",
      "prompt_kind": "main_action",
      "select": {
        "kind": "move_card",
        "iid": "$primary",
        "direction": "field_to_base"
      }
    },
    {
      "name": "Choose the legal target",
      "prompt_kind": "effect_target",
      "select": {
        "kind": "effect_target",
        "cardIid": "$yellow_target"
      }
    }
  ],
  "assertions": [
    {
      "name": "Guardian Monkey retreats to Base",
      "path": "state.players.human.base",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "yellow_02_01_03_01"
      }
    },
    {
      "name": "The chosen Yellow Minion receives +300BP this turn",
      "path": "state.players.human.field",
      "op": "any_where",
      "where": {
        "cardId": "yellow_01_01_03_00",
        "effectiveBp": 500
      }
    },
    {
      "name": "The Blue Minion is not buffed",
      "path": "state.players.human.field",
      "op": "any_where",
      "where": {
        "cardId": "blue_01_01_03_00",
        "effectiveBp": 200
      }
    }
  ]
}