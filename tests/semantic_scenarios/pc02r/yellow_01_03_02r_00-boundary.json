      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "declare the boosted Minion’s attack",
      "prompt_kind": "main_action",
      "select": {
        "kind": "attack",
        "cardId": "white_08_02_01_00"
      }
    },
    {
      "name": "target the opponent Force",
      "prompt_kind": "attack_target",
      "select": {
        "kind": "force",
        "forceId": "force_sho"
      }
    },
    {
      "name": "pass opponent priority before Build Up",
      "prompt_kind": "flash_action",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "name": "play Build Up during Flash",
      "prompt_kind": "flash_action",
      "select": {
        "kind": "play_card",
        "cardId": "yellow_01_03_02r_00"
      }
    },
    {
      "name": "choose the attacking Minion",
      "prompt_kind": "effect_target",
      "select": {
        "cardIid": "$attacker"
      }
    },
    {
      "name": "pass opponent priority after Build Up",
      "prompt_kind": "flash_action",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "name": "pass controller priority after Build Up",
      "prompt_kind": "flash_action",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "name": "choose the stronger blocker",
      "prompt_kind": "blocker",
      "select": {
        "kind": "blocker",
        "cardIid": "$blocker"
      }
    }
  ],
  "assertions": [
    {
      "name": "the selected Minion loses to the stronger blocker",
      "path": "state.players.opponent.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "white_08_02_01_00",
        "effectiveBp": 1300
      }
    },
    {
      "name": "Build Up remains in Trash when its Minion loses",
      "path": "state.players.human.trash",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "yellow_01_03_02r_00"
      }
    },
    {
      "name": "Build Up is not returned after a loss",
      "path": "state.players.human.hand",
      "op": "count_where",
      "value": 0,
      "where": {
        "cardId": "yellow_01_03_02r_00"
      }
    }
  ]
