        "rested": false
      },
      "capture": {
        "attacker": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "white_08_02_01_00",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
