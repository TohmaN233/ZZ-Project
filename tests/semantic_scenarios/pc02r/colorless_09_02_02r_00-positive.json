{
  "schema_version": 1,
  "scenario_id": "colorless_09_02_02r_00_positive",
  "card_id": "colorless_09_02_02r_00",
  "scenario_kind": "positive",
  "official_rule": "JP: 【召喚時】自分の破壊されたフォース1つ毎に、相手のミニオン1体を破壊する。",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_09_02_02r_00",
        "zone": "hand",
        "seed": 3552303258,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "card": {
          "where": {
            "cardId": "colorless_09_02_02r_00"
          },
          "field": "iid",
          "path": "state.players.human.hand"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "payload": {
        "cardId": "colorless_02_02_02r_00",
        "side": "P2",
        "rested": false,
        "zone": "field"
      },
      "capture": {
        "enemy_one": {
          "path": "debug.added.iid"
        }
      },
      "path": "/api/debug/add-card"
    },
    {
      "payload": {
        "cardId": "colorless_03_02_02r_00",
        "side": "P2",
        "rested": false,
        "zone": "field"
      },
      "capture": {
        "enemy_two": {
          "path": "debug.added.iid"
        }
      },
      "path": "/api/debug/add-card"
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main",
        "activeSide": "P1"
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "rested": true,
        "destroyed": true,
        "forceIndex": 0
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "rested": true,
        "destroyed": true,
        "forceIndex": 1
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "summon Vengeance Dragon",
      "select": {
        "kind": "play_card",
        "cardId": "colorless_09_02_02r_00"
      }
    },
    {
      "select_many": [
        {
          "cardIid": "$enemy_one"
        },
        {
          "cardIid": "$enemy_two"
        }
      ],
      "prompt_kind": "effect_target",
      "name": "destroy one opposing minion per destroyed Force"
    }
  ],
  "assertions": [
    {
      "where": {
        "iid": "$enemy_one"
      },
      "value": 1,
      "name": "the first opposing minion is destroyed",
      "op": "count_where",
      "path": "state.players.opponent.trash"
    },
    {
      "where": {
        "iid": "$enemy_two"
      },
      "value": 1,
      "name": "the second opposing minion is destroyed",
      "op": "count_where",
      "path": "state.players.opponent.trash"
    },
    {
      "where": {
        "cardId": "colorless_09_02_02r_00"
      },
      "value": 1,
      "name": "Vengeance Dragon remains on the field",
      "op": "count_where",
      "path": "state.players.human.field"
    }
  ]
}
