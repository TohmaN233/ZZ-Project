  "actions": [
    {
      "name": "Bless Blue Night Owl with no Field Minion in the look",
      "prompt_kind": "main_action",
      "select": {
        "kind": "bless",
        "iid": "$yellow_mana",
        "target_iid": "$owl"
      }
    }
  ],
  "assertions": [
    {
      "name": "no Magic card enters hand as a Field Minion",
      "path": "state.players.human.hand",
      "op": "none_where",
      "where": {
        "cardId": "yellow_01_03_02r_00"
      }
    },
    {
      "name": "a private look does not publish an unselected card",
      "path": "state.publicReveals",
      "op": "length_eq",
      "value": 0
    },
    {
