      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "place Fiora without a cost-seven target",
      "select": {
        "kind": "play_to_base",
        "cardIid": "$source"
      }
    },
    {
      "prompt_kind": "effect_target",
      "name": "replace one Minion to make room for Slime Block",
      "select": {
        "cardIid": "$replacement_candidate"
      }
    }
  ],
  "assertions": [
    {
      "name": "placement creates one Slime Block at capacity",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "slime_block_token"
      }
    },
    {
      "name": "a non-token Minion is replaced through the shared capacity rule",
      "path": "state.players.human.trash",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$replacement_candidate"
      }
    },
    {
      "name": "cost-six Minion receives no Boost stats",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$only_low_cost_host",
        "effectiveBp": 500,
        "effectiveDp": 2
      }
    },
    {
      "name": "the Field remains at capacity",
      "path": "state.players.human.field",
      "op": "length_eq",
      "value": 5
    }
  ]
}
