{
  "schema_version": 1,
  "scenario_id": "white_04_02_02r_01_positive",
  "card_id": "white_04_02_02r_01",
  "scenario_kind": "positive",
  "official_rule": "JP: 【相手の夕\\n自分のフォースが相手のミニオンにアタックされる\\nたぴ、このミニオンをアクティブにする。 EN: [On Your Opponent's Turn]\\nWhenever one of your Forces is attacked\\nby one of your opponent's minions, this\\nminion enters the Active State.",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "white_04_02_02r_01",
        "zone": "hand",
        "seed": 2712157656,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": false
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "white_04_02_02r_01",
        "side": "P1",
        "zone": "field",
        "rested": true
      },
      "capture": {
        "reactor": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "colorless_02_02_02r_01",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "other_blocker": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "purple_03_02_02r_01",
        "side": "P2",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "opponent_attacker": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P2",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "mana"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "P2 places turn-start Mana",
      "select": {
        "kind": "place_colorless_mana"
      }
    },
    {
      "prompt_kind": "main_action",
      "name": "P2 attacks P1 Force",
      "select": {
        "kind": "attack",
        "cardId": "purple_03_02_02r_01"
      }
    },
    {
      "prompt_kind": "attack_target",
      "name": "target P1 Sho Force",
      "select": {
        "forceId": "force_sho"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "P1 passes Flash priority",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "flash_action",
      "name": "P2 passes Flash priority",
      "select": {
        "kind": "flash_pass"
      }
    },
    {
      "prompt_kind": "blocker",
      "name": "decline the optional block",
      "select": {
        "id": "none"
      }
    }
  ],
  "assertions": [
    {
      "name": "reactor refreshes after an opponent attacks its Force",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$reactor",
        "rested": false
      }
    },
    {
      "name": "declining block leaves other Minion ready",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$other_blocker",
        "rested": false
      }
    }
  ]
}
