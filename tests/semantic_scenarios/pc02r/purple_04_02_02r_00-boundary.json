{
  "schema_version": 1,
  "scenario_id": "purple_04_02_02r_00_boundary",
  "card_id": "purple_04_02_02r_00",
  "scenario_kind": "boundary",
  "official_rule": "JP: 【常時】\\nこの二オには条件を無視して[加を付与せるこ\\nとができる。\\n【アタック時】\\nお互いのデッキを上から1枚ずつ破棄する。\\n【加護時】\\n紫以外の有色の加護である場合、加護しているマナを除外\\nして、その色に応じ姿に大変身する。 EN: [Passive]\\nThis minion can receive the {Boost} effect while ignoring\\nany required conditions.\\n[When Attacking]\\nDiscard the top card from your and your opponent's deck\\n[When Boosted]\\nIf Boosted by a Color Mana that is not Purple, banish that\\nmana. This card will Metamorphose according to that color",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_04_02_02r_01",
        "zone": "field",
        "seed": 1018297445,
        "playerForces": [
          "force_e",
          "force_kon"
        ],
        "opponentForces": [
          "force_e",
          "force_kon"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true,
        "rested": false
      },
      "capture": {
        "prepared_form_0": {
          "path": "state.players.human.field",
          "where": {
            "cardId": "colorless_04_02_02r_01"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/fixture/transform-card",
      "payload": {
        "iid": "$prepared_form_0",
        "sourceId": "colorless_04_02_02r_01",
        "targetId": "purple_04_02_02r_00"
      }
    },
    {
      "path": "/fixture/return-to-hand",
      "payload": {
        "iid": "$prepared_form_0"
      }
    },
    {
      "path": "/api/debug/move-card",
      "payload": {
        "iid": "$prepared_form_0",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "host": {
          "path": "debug.moved.iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "purple_00_01_02_00",
        "side": "P1",
        "zone": "base",
        "rested": false
      },
      "capture": {
        "purple_mana": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "main"
      }
    }
  ],
  "actions": [
    {
      "name": "attach matching Purple Bless mana",
      "prompt_kind": "main_action",
      "select": {
        "kind": "bless",
        "iid": "$purple_mana",
        "target_iid": "$host"
      }
    }
  ],
  "assertions": [
    {
      "name": "Anju remains in the Field with the matching-color Bless attached",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "purple_04_02_02r_00",
        "blessings": {
          "contains": [
            {
              "cardId": "purple_00_01_02_00"
            }
          ]
        }
      }
    },
    {
      "name": "matching-color Bless does not banish mana",
      "path": "state.players.human.removedCount",
      "op": "eq",
      "value": 0
    }
  ]
}
