{
  "schema_version": 1,
  "scenario_id": "colorless_00_01_02r_00_positive",
  "card_id": "colorless_00_01_02r_00",
  "scenario_kind": "positive",
  "official_rule": "JP: 《ベース》\\n【配置時】\\n「スライム・ブロック\\nトークン」1体を出す。 EN: ere\\n<Base> [When Placed]\\nOne Token Slime Block enters your\\nfield.\\nBoost: All + Cost 7 or Higher",
  "setup": [
    {
      "path": "/api/debug/setup",
      "payload": {
        "cardId": "colorless_00_01_02r_00",
        "zone": "hand",
        "seed": 587176939,
        "playerForces": [
          "force_sho",
          "force_chi"
        ],
        "opponentForces": [
          "force_sho",
          "force_chi"
        ],
        "compactBoard": true,
        "nonMinionManaOnly": true
      },
      "capture": {
        "source": {
          "path": "state.players.human.hand",
          "where": {
            "cardId": "colorless_00_01_02r_00"
          },
          "field": "iid"
        }
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P1",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 0,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/force-state",
      "payload": {
        "side": "P2",
        "forceIndex": 1,
        "destroyed": false,
        "rested": true
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "white_07_02_02r_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "high_cost_host": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/add-card",
      "payload": {
        "cardId": "white_06_02_02r_00",
        "side": "P1",
        "zone": "field",
        "rested": false
      },
      "capture": {
        "low_cost_host": {
          "path": "debug.added.iid"
        }
      }
    },
    {
      "path": "/api/debug/fixed-board",
      "payload": {
        "activeSide": "P1",
        "controlBoth": true,
        "preserveBoard": true,
        "step": "mana"
      }
    }
  ],
  "actions": [
    {
      "prompt_kind": "main_action",
      "name": "place Fiora in Base",
      "select": {
        "kind": "play_to_base",
        "cardId": "colorless_00_01_02r_00"
      }
    },
    {
      "prompt_kind": "main_action",
      "name": "Bless the cost-seven allied Minion",
      "select": {
        "kind": "bless",
        "iid": "$source",
        "target_iid": "$high_cost_host"
      }
    }
  ],
  "assertions": [
    {
      "name": "placement creates one Slime Block",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "cardId": "slime_block_token"
      }
    },
    {
      "name": "cost-seven host receives Fiora Boost stats",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$high_cost_host",
        "effectiveBp": 900,
        "effectiveDp": 3
      }
    },
    {
      "name": "cost-six host receives no Boost stats",
      "path": "state.players.human.field",
      "op": "count_where",
      "value": 1,
      "where": {
        "iid": "$low_cost_host",
        "effectiveBp": 500,
        "effectiveDp": 2
      }
    }
  ]
}
