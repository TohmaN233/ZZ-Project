{
  "name": "zenonzard-clone",
  "version": "0.5.3",
  "private": true,
  "description": "Local Zenonzard clone and debugging client.",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "electron:dev": "electron .",
    "electron:start": "electron .",
    "electron:build-main": "esbuild electron/main.js --bundle --platform=node --format=cjs --outfile=dist/electron/main.cjs --external:electron --external:7zip-bin",
    "package:windows": "python packaging/build_windows_package.py",
    "package:linux": "python packaging/build_linux_bundle.py",
    "test:update-checker": "node --test tests/electron_update_checker.test.js",
    "test:asset-bootstrap": "node --test tests/electron_asset_bootstrap.test.js tests/electron_asset_setup.test.js tests/electron_asset_transport.test.js",
    "test:multiplayer-electron": "node --test tests/electron_multiplayer_client.test.js tests/electron_lan_manager.test.js tests/electron_adaptive_websocket.test.js",
    "check:brain-manifest": "repo-harness run check-brain-manifest",
    "check:context-files": "repo-harness run check-context-files",
    "check:deploy-sql": "repo-harness run check-deploy-sql-order",
    "check:architecture-sync": "repo-harness run check-architecture-sync",
    "check:task-sync": "repo-harness run check-task-sync",
    "check:task-workflow": "repo-harness run check-task-workflow --strict",
    "sync:brain-docs": "repo-harness run sync-brain-docs --all",
    "package:source": "python packaging/build_source_package.py --kind all"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "https-proxy-agent": "^7.0.6",
    "ws": "^8.21.1"
  },
  "build": {
    "appId": "com.tohman233.zzproject",
    "productName": "ZZ-Project",
    "asar": false,
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "electron/**/*",
      "zz/**/*",
      "data/*.tsv",
      "data/ai_training/quality_tactical_latest/best_league.json",
      "docs/rules/**/*",
      "image.png",
      "package.json",
      "node_modules/**/*",
      "!asserts{,/**/*}",
      "!zz/**/__pycache__{,/**/*}",
      "!zz/**/*.pyc"
    ],
    "extraResources": [
      {
        "from": "packaging/server-dist/zz-server.exe",
        "to": "server/zz-server.exe"
      },
      {
        "from": "data/decks",
        "to": "default-decks",
        "filter": [
          "aice.json",
          "deck-060837.json",
          "deck-b70677.json",
          "deck-c80751.json",
          "deck-e83cf0.json",
          "deck-f9b075.json",
          "deck.json",
          "h.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon-256.png"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "ZZ-Project-v${version}-Windows-Setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    }
  }
}
