[Unit]
Description=ZZ authoritative multiplayer server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zz
Group=zz
WorkingDirectory=/opt/zz
EnvironmentFile=/etc/zz-multiplayer.env
ExecStart=/opt/zz/.venv/bin/python -m zz.multiplayer.deployment_server
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
